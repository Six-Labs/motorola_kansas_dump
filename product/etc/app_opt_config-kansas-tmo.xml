<?xml version="1.0" encoding="utf-8"?>
<!--
    App optimizations device config
-->
<app-optimization version="1">

    <devconfig>
        <thermal-sensor>BACK_TEMP</thermal-sensor>
        <default-thermal>15</default-thermal>
        <profile name="boost1">0x00400000,0x3D0900,0x00400100,0x3D0900,0x00410000,0x1,0x01000000,0x0,0x01404300,0x1,0x01408100,0x64,0x01408300,0x64,0x01438300,0x0,0x01438400,0x0,0x01438600,
        0xEA60,0x01438700,0xEA60,0x02050000,0x0,0x03000000,0x8,0x03400000,0x3,0x02c1c000,0x1</profile>
        <profile name="boost2">0x00400000,0x3D0900,0x00400100,0x3D0900,0x00410000,0x1,0x01000000,0x0,0x01404300,0x1,0x01408100,0x64,0x01408300,0x64,0x01438300,0x0,0x01438400,0x0,0x01438600,
        0xEA60,0x01438700,0xEA60,0x02050000,0x0,0x03000000,0x8,0x03400000,0x3,0x02c1c000,0x1</profile>
    </devconfig>

    <!-- classified apps -->
    <optimization name="base_app">
        <supported-modes>video_mode, video_fullscreen_mode, camera_mode</supported-modes>
        <default-rr>auto</default-rr>
        <limit rr="90"/>
        <limit temp="44" tempClr="42" rr="60"/>
    </optimization>

    <optimization name="rr_opt_app" parent="base_app">
    </optimization>

    <optimization name="rr_limit_app" parent="rr_opt_app">
    </optimization>

    <optimization name="reading_app" parent="rr_opt_app">
        <idle-fps>30</idle-fps>
    </optimization>

    <optimization name="navigation_app" parent="rr_opt_app">
        <idle-fps>30</idle-fps>
    </optimization>

    <optimization name="rr_deep_opt_app" parent="rr_opt_app">
        <min-fps>30</min-fps>
    </optimization>

    <optimization name="low_latency_app" parent="base_app">
        <llm>true</llm>
    </optimization>

    <optimization name="normal_app" parent="base_app">
    </optimization>

    <optimization name="heavy_load_app">
        <boost rr="120" profile="boost2"/>
    </optimization>

    <optimization name="heavy_load_lite_app">
        <boost profile="boost1"/>
    </optimization>

    <!-- recognized in-app modes, will merge with app opt at runtime -->
    <optimization name="video_mode">
        <default-rr>auto</default-rr>
    </optimization>

    <optimization name="video_fullscreen_mode">
        <default-rr>video</default-rr>
    </optimization>

    <!-- global modes -->
    <optimization name="charging_mode">
        <thermal>16</thermal>
    </optimization>

    <optimization name="camera_mode">
        <thermal>17</thermal>
    </optimization>

    <!-- limit rr to 90 if battery low (<20%), only for normal apps -->
    <optimization name="battery_low_mode">
        <limit rr="90" />
    </optimization>

    <optimization name="bright_throttle_mode">
        <limit temp="48" tempClr="42" brt-throttle="0:800"/>
        <limit temp="49" tempClr="43" brt-throttle="0:700"/>
        <limit temp="50" tempClr="44" brt-throttle="0:500"/>
        <limit temp="51" tempClr="45" brt-throttle="0:200"/>
    </optimization>

    <optimization name="device_hot_mode">
        <thermal-sensor>TSPK_NTC</thermal-sensor>
        <limit temp="47" tempClr="45" vol="74"/>
    </optimization>

    <!-- apps NOT applicable for autoRR  -->
    <optimization name="non_autorr_app">
        <supported-modes>video_mode, video_fullscreen_mode, camera_mode</supported-modes>
        <limit rr="90"/>
        <limit temp="44" tempClr="42" rr="60"/>
    </optimization>

    <optimization name="com.google.android.apps.restore" refs="non_autorr_app"/>
    <optimization name="com.android.cts.graphics.framerateoverride" refs="non_autorr_app"/>
    <optimization name="android.display.cts" refs="non_autorr_app"/>
    <optimization name="android.graphics.cts" refs="non_autorr_app"/>
    <optimization name="android.view.cts" refs="non_autorr_app"/>
    <optimization name="com.google.android.dialer" refs="non_autorr_app"/>
    <optimization name="com.google.android.calculator" refs="non_autorr_app"/>>
    <optimization name="com.zui.browser" refs="non_autorr_app"/>
    <optimization name="com.android.chrome" refs="non_autorr_app"/>
    <optimization name="com.taobao.taobao" refs="non_autorr_app"/>
    <optimization name="com.tencent.mm" parent="non_autorr_app">
        <llm>true</llm>
    </optimization>

    <optimization name="com.motorola.launcher3"/>

</app-optimization>
